# =============================================================================
# LabPilot API — Production Environment Variables
# Copy this file and fill in real values before deploying.
# NEVER commit a filled-in .env.prod to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL credentials
# Used by both the 'db' service and DATABASE_URL below.
# -----------------------------------------------------------------------------

# Name of the PostgreSQL database
POSTGRES_DB=labpilot

# PostgreSQL login user
POSTGRES_USER=labpilot

# PostgreSQL password — replace with a strong random value in production
# e.g.: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# -----------------------------------------------------------------------------
# Application database connection string
# Built from the variables above; update if you change host/port.
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<db>
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://labpilot:CHANGE_ME_strong_password_here@db:5432/labpilot

# -----------------------------------------------------------------------------
# Application secret key — used for signing tokens / sessions
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# -----------------------------------------------------------------------------
SECRET_KEY=CHANGE_ME_generate_a_real_secret_key_here

# -----------------------------------------------------------------------------
# Runtime environment tag (development | staging | production)
# -----------------------------------------------------------------------------
APP_ENV=production

# -----------------------------------------------------------------------------
# Human-readable application name (used in logs / API responses)
# -----------------------------------------------------------------------------
APP_NAME=LabPilot API

# -----------------------------------------------------------------------------
# URL prefix for all API routes (e.g. /api means /api/projects, /api/tasks …)
# -----------------------------------------------------------------------------
API_PREFIX=/api

# -----------------------------------------------------------------------------
# Comma-separated list of allowed Host header values.
# Set to your actual domain/NAS hostname in production.
# '*' accepts any host — fine behind a private NAS, tighten for public deploys.
# -----------------------------------------------------------------------------
ALLOWED_HOSTS=rnd.hyunsu5203.synology.me

# -----------------------------------------------------------------------------
# CORS — allowed origins for browser clients
# Set to your actual frontend URL in production.
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=["https://rnd.hyunsu5203.synology.me"]

# -----------------------------------------------------------------------------
# Directory inside the container where uploaded files are stored.
# Must match the volume mount target in docker-compose.prod.yml.
# -----------------------------------------------------------------------------
UPLOAD_DIR=/data/uploads
